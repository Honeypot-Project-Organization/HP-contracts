{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "top-countries.schema.json",
  "title": "TopCountries",
  "description": "GET /api/stats/top-countries: countries ranked by sessions, then IPs, across ALL IPs.",
  "type": "object",
  "required": [
    "countries",
    "located",
    "total",
    "pending"
  ],
  "additionalProperties": true,
  "properties": {
    "countries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "name",
          "ips",
          "sessions"
        ],
        "additionalProperties": true,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "name": {
            "type": "string"
          },
          "ips": {
            "type": "integer",
            "minimum": 0
          },
          "sessions": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "located": {
      "type": "integer",
      "minimum": 0,
      "description": "IPs with a known country."
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "description": "All IPs."
    },
    "pending": {
      "type": "integer",
      "minimum": 0,
      "description": "IPs not looked up yet."
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "geo-status.schema.json",
  "title": "GeoStatus",
  "description": "GET /api/geo/status",
  "type": "object",
  "required": [
    "city",
    "asn",
    "available"
  ],
  "properties": {
    "city": {
      "type": [
        "object",
        "null"
      ],
      "description": "geoip_meta document without _id/version: chunks, size, sha256, uploaded_at, source"
    },
    "asn": {
      "type": [
        "object",
        "null"
      ]
    },
    "available": {
      "type": "boolean"
    }
  }
}

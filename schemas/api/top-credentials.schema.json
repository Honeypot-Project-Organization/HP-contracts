{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "top-credentials.schema.json",
  "title": "TopCredentials",
  "description": "GET /api/stats/top-credentials?limit=N (1-100). Attacker-controlled strings.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "username",
      "password",
      "count"
    ],
    "properties": {
      "username": {
        "type": [
          "string",
          "null"
        ]
      },
      "password": {
        "type": [
          "string",
          "null"
        ]
      },
      "count": {
        "type": "integer",
        "minimum": 1
      }
    }
  }
}

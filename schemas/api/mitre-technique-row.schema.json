{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mitre-technique-row.schema.json",
  "title": "MitreTechniqueRow",
  "description": "One technique with its counts.",
  "type": "object",
  "required": [
    "id",
    "basis",
    "occurrences",
    "ips"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^T\\d{4}(?:\\.\\d{3})?$",
      "description": "ATT&CK technique id, e.g. T1082 or T1110.001. Heuristic tag, not a confirmed technique."
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "tactics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "basis": {
      "enum": [
        "event",
        "command"
      ]
    },
    "occurrences": {
      "type": "integer",
      "minimum": 0
    },
    "ips": {
      "type": "integer",
      "minimum": 0
    },
    "last_seen": {
      "type": [
        "string",
        "null"
      ],
      "description": "ISO 8601 timestamp (UTC)."
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mitre-daily.schema.json",
  "title": "MitreDaily",
  "description": "GET /api/mitre/{id}/daily?days=30: occurrences per UTC day (days without data are omitted).",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "date",
      "count"
    ],
    "properties": {
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "count": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
